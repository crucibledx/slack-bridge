{
  "name": "tundish",
  "version": "0.0.0",
  "private": true,
  "description": "Slack bridge for the Crucible workstreams: a Cloudflare Worker",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "bun test",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/bun": "^1.4.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "wrangler": "4.168.0"
  }
}
