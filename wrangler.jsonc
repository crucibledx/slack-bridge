{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tundish",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": {
    "enabled": true,
  },
  // No id: wrangler provisions the namespace on the first deploy and keeps it linked.
  "kv_namespaces": [{"binding": "BRIDGE_KV"}],
  "durable_objects": {
    "bindings": [{"name": "RELAY_GATE", "class_name": "RelayGate"}],
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["RelayGate"]}],
}
